# SafeSignal Frontend Environment Configuration Example
# Copy this file to .env in your frontend directory

# Google OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins: http://localhost:5173, http://127.0.0.1:5173
VITE_GOOGLE_CLIENT_ID=
VITE_BACKEND_URL=http://localhost:8000
