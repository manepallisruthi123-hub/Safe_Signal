# SafeSignal Environment Configuration Example
# Copy this file to .env in your root or backend directory.

# Server configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Demo Mode (true by default)
DEMO_MODE=true

# AI & RAG Configuration
# If provided, Gemini 1.5 Flash will be used for answer synthesis grounded in retrieved FAISS documents.
# If omitted, SafeSignal uses its built-in high-precision deterministic retrieval synthesis.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Embedding Model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Optional Persistent Database Integration (Supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# Google OAuth 2.0 Credentials (Sign In with Google)
# Create a Web Client ID at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins: http://localhost:5173, http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

